{
  "rules": {
    "destinations": { ".read": true, ".write": "auth != null && (auth.token.admin === true || auth.token.email === 'yth6263@gmail.com')" },
    "stays": { ".read": true, ".write": "auth != null && (auth.token.admin === true || auth.token.email === 'yth6263@gmail.com')" },
    "members": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true || auth.token.email === 'yth6263@gmail.com')",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'phone', 'email', 'createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 20"
        },
        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "bookings": {
      ".read": "auth != null && (auth.token.admin === true || auth.token.email === 'yth6263@gmail.com' || (query.orderByChild === 'userId' && query.equalTo === auth.uid))",
      ".indexOn": ["userId"],
      "$bookingId": {
        ".write": "auth != null && (auth.token.admin === true || auth.token.email === 'yth6263@gmail.com' || (!data.exists() && newData.child('userId').val() === auth.uid && newData.child('email').val() === auth.token.email))"
      }
    }
  }
}
